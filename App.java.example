package org.example;


import com.alibaba.fastjson2.JSONObject;
import jakarta.websocket.DeploymentException;
import pojo.Credential;
import java.io.IOException;

import java.net.URISyntaxException;

import java.security.InvalidKeyException;
import java.security.NoSuchAlgorithmException;


/**
 * 本地入口示例：复制为 src/main/java/org/example/App.java 后填写下列占位符。
 * 仓库 .gitignore 已忽略 App.java，请勿把真实 Cookie 提交到远程。
 */
public class App {
    public static String cookie = "PASTE_BROWSER_COOKIE_HERE";
    public static void main(String[] args) throws IOException, NoSuchAlgorithmException, InvalidKeyException, URISyntaxException, DeploymentException {

        BiliRequest biliReqest = new BiliRequest(cookie);
        int roomIdForApi = 0; // TODO: 替换为直播间长号（room_id）
        JSONObject danmuInfoData = biliReqest.getDanmuInfoData(roomIdForApi);
        int uid = 0; // TODO: 替换为你的 B 站 UID
        String buvid3 = "buvid3=..."; // TODO: 与浏览器一致的 buvid3 串
        Credential credential = new Credential(uid, danmuInfoData.getInteger("room_id"), buvid3, danmuInfoData.getString("token"));
        BiliDanmuWebSocketClient client = new BiliDanmuWebSocketClient(BiliDanmuWebSocketClient.generateUri(danmuInfoData), credential);
        try {
            PlaylistHttpServer server = new PlaylistHttpServer(8080);
            System.out.println("Playlist HTTP server started at http://127.0.0.1:8080/playlist.html");
        } catch (IOException e) {
            System.err.println("启动 PlaylistHttpServer 失败: " + e.getMessage());
        }

        client.connect();

    }
}
